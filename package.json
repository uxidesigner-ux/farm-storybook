{
  "name": "farm-storybook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "프리미엄 농작물 프로젝트의 BX, 디자인, 개발, 마케팅을 함께 기록하는 Storybook",
  "scripts": {
    "dev": "npm run content && node scripts/dev.mjs",
    "dev:operations": "npm run content && node scripts/dev.mjs --edition=operations",
    "dev:showcase": "npm run content && vite --config vite.showcase.config.ts --host 0.0.0.0",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0 --no-open",
    "content": "node scripts/generate-content.mjs && node scripts/generate-portals.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-portals.mjs",
    "build:journal": "npm run content && storybook build -c .storybook -o dist/journal --disable-telemetry",
    "build:operations": "npm run content && storybook build -c .storybook-operations -o dist/operations --disable-telemetry",
    "build:showcase": "vite build --config vite.showcase.config.ts",
    "check": "npm run typecheck && node scripts/validate-content.mjs && node scripts/validate-portals.mjs && node services/voting/verify.mjs",
    "verify:build": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.71.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "storybook": "10.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
